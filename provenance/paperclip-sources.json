      "/usr/bin/tini",
      "-s",
      "--",
      "docker-entrypoint.sh"
    ],
    "command": [
      "node",
      "server/dist-runtime/index.mjs"
    ],
    "state_root": "/paperclip",
    "provider_pack": "/opt/paperclip-runner/provider-pack",
    "provider_pack_note": "Preserve image-native paperclip-runnerd and stamped provider-pack files together. They are used by native Runner and are distinct from legacy CLI adapters.",
    "pinned_runner_opencode_package": "opencode-ai@1.18.34",
    "image_global_cli_note": "Dockerfile installs several CLI packages with latest or unversioned npm specifiers. The root bundle pins the standalone OpenCode executable and uses an explicit adapter command path.",
    "official_external_database_compose": "sources/paperclip/docker/docker-compose.yml",
    "official_embedded_database_compose": "sources/paperclip/docker/docker-compose.quickstart.yml",
    "offline_compose_note": "Official compose recipes use build. Use imported pinned runtime images; no offline docker build is implied.",
    "official_compose_shutdown_seconds": 90,
    "official_compose_pids_limit": 2048
  },
  "local_trusted": {
    "environment": {
      "PAPERCLIP_DEPLOYMENT_MODE": "local_trusted",
      "PAPERCLIP_BIND": "loopback",
      "HOST": "127.0.0.1",
      "PORT": "3100",
      "PAPERCLIP_TELEMETRY_DISABLED": "1",
      "DO_NOT_TRACK": "1"
    },
    "constraints": [
      "Server refuses local_trusted on a nonloopback bind.",
      "A Linux host-network container allows localhost-only host access. Remote UI can use an SSH tunnel.",
      "No Authorization or Origin is needed for localhost API; implicit Local Board has instance administrator privileges.",
      "Use authenticated mode with a stable BETTER_AUTH_SECRET for shared network access; the bundle does not silently turn local_trusted into a LAN service."
    ],
    "auth_bootstrap": "BetterAuth is not instantiated in local_trusted; the local board principal is initialized by the server."
  },
  "api_contracts": {
    "create_company": {
      "method": "POST",
      "path": "/api/companies",
      "body": {
        "name": "Offline Engineering",
        "description": "Private multi-project workspace"
      }
    },
    "create_project": {
      "method": "POST",
      "path": "/api/companies/{companyId}/projects",
      "body": {
        "name": "Project A",
        "workspace": {
          "sourceType": "local_path",
          "cwd": "/workspaces/project-a",
          "isPrimary": true
        }
      }
    },
    "create_legacy_opencode_agent": {
      "method": "POST",
      "path": "/api/companies/{companyId}/agents",
      "body": {
        "name": "OpenCode Engineer",
        "role": "engineer",
        "adapterType": "opencode_local",
        "runner": "legacy",
        "adapterConfig": {
          "command": "/opt/offline/bin/opencode",
          "model": "internal/model-id",
          "cwd": "/workspaces/project-a",
          "timeoutSec": 1800
        },
        "runtimeConfig": {
          "heartbeat": {
            "enabled": false,
            "intervalSec": 0,
            "wakeOnDemand": false,
            "maxConcurrentRuns": 1
          }
        }
      }
    },
    "install_compiled_omp_adapter": {
      "method": "POST",
      "path": "/api/adapters/install",
      "body": {
        "packageName": "/opt/offline/adapters/paperclip-omp-adapter-0.7.0",
        "isLocalPath": true
      }
    },
    "create_legacy_omp_agent": {
      "method": "POST",
      "path": "/api/companies/{companyId}/agents",
      "body": {
        "name": "OMP Engineer",
        "role": "engineer",
        "adapterType": "omp_local",
        "runner": "legacy",
        "adapterConfig": {
          "command": "/opt/offline/bin/omp",
          "model": "internal/model-id",
          "agentDir": "/paperclip/omp-agent",
          "cwd": "/workspaces/project-a",
          "approvalMode": "yolo",
          "timeoutSec": 1800
        },
        "runtimeConfig": {
          "heartbeat": {
            "enabled": false,
            "intervalSec": 0,
            "wakeOnDemand": false,
            "maxConcurrentRuns": 1
          }
        }
      }
    },
    "notes": [
      "Paths and model IDs in examples are templates and must match mounted artifacts and configured internal model provider.",
      "Company requireBoardApprovalForNewAgents defaults false in this release; if an existing company enables it, direct agent creation409 requires its approval flow, not silent governance changes.",
      "OMP installation requires the compiled dist tree and bundled production node_modules accessible to Paperclip. isLocalPath:true skips npm.",
      "Agent configuration supports runner auto, paperclip, legacy. The legacy CLI route is deliberate here; it does not claim native Runner child-worker introspection.",
      "Heartbeat defaults are intentionally inert until provider and sandbox acceptance checks pass; wakeOnDemand is the non-timer execution gate."
    ]
  },
