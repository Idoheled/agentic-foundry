    "source_sha_tag": "ghcr.io/paperclipai/paperclip:sha-c0f1328",
    "docker_target": "production",
    "image_digest_note": "The root bundle image manifest records the retrieved linux/amd64 digest. Do not replace with latest or the cloud variant.",
    "container_node_major": 24,
